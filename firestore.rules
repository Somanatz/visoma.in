
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * VISOMA CORE SECURITY RULES
     * Updated: Enforced robust Query-Aware Permissions for public content.
     * Force Redeploy: Added explicit list rule for blogPosts to ensure public visibility.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function isCreatingCorrectOwner(userIdField) {
      return request.resource.data[userIdField] == request.auth.uid;
    }

    // --- Collection Rules ---

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /solutions/{solutionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /caseStudies/{caseStudyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogPosts/{blogPostId} {
      // Standard QAP: Query must filter by isPublished == true for public access.
      // Split read into get/list for absolute clarity.
      allow get: if isAdmin() || (resource.data.isPublished == true);
      allow list: if isAdmin() || (request.query.limit <= 100 && resource.data.isPublished == true);
      allow write: if isAdmin();
    }

    match /blogTags/{blogTagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contactInquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /companyInfo/visoma {
      allow get: if true;
      allow list: if false;
      allow create, delete: if false;
      allow update: if isAdmin();
    }

    match /freelancerProfiles/{freelancerId} {
      allow get, list: if (resource.data.availabilityStatus == 'Available') || isOwner(freelancerId) || isAdmin();
      allow create: if isOwner(freelancerId) && isCreatingCorrectOwner('userId');
      allow update: if (isExistingOwner(freelancerId) && request.resource.data.userId == resource.data.userId) || isAdmin();
      allow delete: if isExistingOwner(freelancerId) || isAdmin();
    }

    match /freelancerProfiles/{freelancerId}/education/{educationId} {
      allow read: if (resource.data.freelancerAvailabilityStatus == 'Available') || isOwner(freelancerId) || isAdmin();
      allow create: if isOwner(freelancerId) && isCreatingCorrectOwner('freelancerId');
      allow update: if (isExistingOwner(freelancerId) && request.resource.data.freelancerId == resource.data.freelancerId) || isAdmin();
      allow delete: if isExistingOwner(freelancerId) || isAdmin();
    }

    match /freelancerProfiles/{freelancerId}/experience/{experienceId} {
      allow read: if (resource.data.freelancerAvailabilityStatus == 'Available') || isOwner(freelancerId) || isAdmin();
      allow create: if isOwner(freelancerId) && isCreatingCorrectOwner('freelancerId');
      allow update: if (isExistingOwner(freelancerId) && request.resource.data.freelancerId == resource.data.freelancerId) || isAdmin();
      allow delete: if isExistingOwner(freelancerId) || isAdmin();
    }

    match /freelancerProfiles/{freelancerId}/projects/{projectId} {
      allow read: if (resource.data.freelancerAvailabilityStatus == 'Available') || isOwner(freelancerId) || isAdmin();
      allow create: if isOwner(freelancerId) && isCreatingCorrectOwner('freelancerId');
      allow update: if (isExistingOwner(freelancerId) && request.resource.data.freelancerId == resource.data.freelancerId) || isAdmin();
      allow delete: if isExistingOwner(freelancerId) || isAdmin();
    }

    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

  }
}
