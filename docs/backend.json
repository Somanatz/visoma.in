
{
  "entities": {
    "Service": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Service",
      "type": "object",
      "description": "Represents a service offered by Visoma, such as AI Automation, Web Scraping, or specific solutions like Legal services and Investments.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "overview": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "useCases": { "type": "array", "items": { "type": "string" } },
        "processDescription": { "type": "string" },
        "callToActionText": { "type": "string" },
        "iconUrl": { "type": "string", "format": "uri" },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "overview", "features", "useCases", "callToActionText"]
    },
    "Solution": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Solution",
      "type": "object",
      "description": "Represents an industry or domain where Visoma offers specialized solutions.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "associatedServiceIds": { "type": "array", "items": { "type": "string" } },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "description", "associatedServiceIds"]
    },
    "CaseStudy": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CaseStudy",
      "type": "object",
      "description": "Details a real-world project demonstrating Visoma's impact.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "problemDescription": { "type": "string" },
        "solutionDescription": { "type": "string" },
        "technologyUsed": { "type": "array", "items": { "type": "string" } },
        "resultsAchieved": { "type": "string" },
        "solutionId": { "type": "string" },
        "thumbnailUrl": { "type": "string", "format": "uri" },
        "clientName": { "type": "string" },
        "clientIndustry": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "slug", "problemDescription", "solutionDescription", "technologyUsed", "resultsAchieved", "solutionId"]
    },
    "BlogPost": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "BlogPost",
      "type": "object",
      "description": "Represents an article or post published on Visoma's blog.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "content": { "type": "string" },
        "authorName": { "type": "string" },
        "publicationDate": { "type": "string", "format": "date-time" },
        "summary": { "type": "string" },
        "thumbnailUrl": { "type": "string", "format": "uri" },
        "tagIds": { "type": "array", "items": { "type": "string" } },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "slug", "content", "authorName", "publicationDate", "summary", "tagIds", "isPublished"]
    },
    "BlogTag": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "BlogTag",
      "type": "object",
      "description": "Represents a tag or category used to organize blog posts.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "slug"]
    },
    "ContactInquiry": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ContactInquiry",
      "type": "object",
      "description": "Stores information submitted by users through contact forms.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "company": { "type": "string" },
        "message": { "type": "string" },
        "submissionDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "message", "submissionDate"]
    },
    "CompanyInfo": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CompanyInfo",
      "type": "object",
      "description": "Stores dynamic content for the 'About' page.",
      "properties": {
        "id": { "type": "string" },
        "missionStatement": { "type": "string" },
        "visionStatement": { "type": "string" },
        "expertiseHighlights": { "type": "array", "items": { "type": "string" } },
        "whyVisomaDescription": { "type": "string" },
        "address": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "missionStatement", "visionStatement", "expertiseHighlights", "whyVisomaDescription", "email"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/services/{serviceId}": { "schema": { "$ref": "#/entities/Service" }, "description": "Public services." },
    "/solutions/{solutionId}": { "schema": { "$ref": "#/entities/Solution" }, "description": "Public solutions." },
    "/caseStudies/{caseStudyId}": { "schema": { "$ref": "#/entities/CaseStudy" }, "description": "Public case studies." },
    "/blogPosts/{blogPostId}": { "schema": { "$ref": "#/entities/BlogPost" }, "description": "Blog posts." },
    "/blogTags/{blogTagId}": { "schema": { "$ref": "#/entities/BlogTag" }, "description": "Blog tags." },
    "/contactInquiries/{inquiryId}": { "schema": { "$ref": "#/entities/ContactInquiry" }, "description": "Contact submissions." },
    "/companyInfo/visoma": { "schema": { "$ref": "#/entities/CompanyInfo" }, "description": "Company singleton." },
    "/roles_admin/{userId}": { "schema": { "type": "object" }, "description": "Admin roles." }
  }
}
